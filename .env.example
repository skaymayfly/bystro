# Zkopíruj do .env a doplň hodnoty. Soubor .env nikdy necommituj.
# Další proměnné přibudou v krocích, kde vzniknou.

# PostgreSQL. Výchozí hodnoty odpovídají docker-compose.yml (jen lokální vývoj).
DATABASE_URL=postgresql://bystro:bystro@localhost:5432/bystro

# Databáze pro integrační testy. Název musí končit na "_test"; testy si ji samy založí.
DATABASE_URL_TEST=postgresql://bystro:bystro@localhost:5432/bystro_test

# Redis: fronty úloh workeru a kontrola stavu webu. Potřebují ho i testy workeru.
REDIS_URL=redis://localhost:6379

# Worker: kolik úloh jedné fronty běží najednou. Nepovinné, výchozí 5.
WORKER_CONCURRENCY=

# Přihlašování (Better Auth). Tajný klíč pro podpis session: aspoň 32 znaků.
# Vygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Veřejná adresa webu. Musí sedět s adresou v prohlížeči, jinak nefunguje přihlášení.
BETTER_AUTH_URL=http://localhost:3000

# Přihlášení přes Google (nepovinné; bez těchto hodnot se tlačítko nezobrazí).
# Redirect URI v Google Cloud Console: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Odesílání systémových e-mailů přes Resend (reset hesla). Bez klíče se e-maily neodešlou.
RESEND_API_KEY=
# Odesílatel; doména musí být ověřená v Resendu. Pro zkoušku: Bystro <onboarding@resend.dev>
EMAIL_FROM=

# Hlášení chyb do Sentry. Nepovinné: bez DSN se Sentry vůbec nezapne a nic se neodesílá.
# SENTRY_DSN = server (web i worker), NEXT_PUBLIC_SENTRY_DSN = prohlížeč (je z principu veřejné).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Úroveň logů: trace, debug, info (výchozí), warn, error, fatal, silent.
LOG_LEVEL=

# ARES (dohledání firmy podle IČO). Nepovinné: prázdné = oficiální veřejné API.
# E2E testy si sem samy dosadí místní server s nahranými odpověďmi.
ARES_BASE_URL=

# E2E testy (Playwright): nepovinné. Když se nepodaří stáhnout Chromium přes
# "pnpm exec playwright install chromium", nastav nainstalovaný prohlížeč: chrome nebo msedge.
E2E_BROWSER_CHANNEL=

# Fakturoid (nepovinné). Potřebuje je web (připojení) i worker (synchronizace); bez nich
# aplikace běží a Fakturoid ukazuje jako „Připravujeme“.
# Adresa pro přesměrování v integraci ve Fakturoidu: <BETTER_AUTH_URL>/api/integrations/fakturoid/callback
# (Fakturoid nedovolí localhost, takže skutečné připojení jde vyzkoušet jen na nasazené adrese).
# Client ID a Secret jsou z integrace ve Fakturoidu: Nastavení → Napojení na jiné aplikace →
# OAuth 2 pro tvůrce aplikací. Kontakt jde do hlavičky User-Agent ("Bystro (e-mail)"),
# kterou Fakturoid vyžaduje. Nastav buď všechny tři, nebo žádnou.
FAKTUROID_CLIENT_ID=
FAKTUROID_CLIENT_SECRET=
INTEGRATIONS_CONTACT_EMAIL=

# iDoklad: aplikace zaregistrovaná na https://developer.idoklad.cz (Flow: AuthorizationCode).
# Nepovinné; bez obou hodnot je iDoklad v aplikaci „Připravujeme“. Stejné hodnoty musí mít
# web i worker. Adresa pro přesměrování: <adresa webu>/api/integrations/idoklad/callback
IDOKLAD_CLIENT_ID=
IDOKLAD_CLIENT_SECRET=

# Gmail (sekce Pošta, upomínky z vlastní schránky): OAuth klient z Google Cloud Console
# (může být stejný jako GOOGLE_CLIENT_ID pro přihlášení, ale zapíná se zvlášť). Nepovinné;
# bez obou hodnot je Gmail „Připravujeme“. Adresa pro přesměrování:
# <adresa webu>/api/integrations/gmail/callback (Google dovolí i http://localhost:3000).
# Potřebuje je web i worker (worker jimi obnovuje přístup ke schránce při synchronizaci pošty).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Jen pro nahrání testovacích odpovědí z vlastního testovacího účtu ve Fakturoidu
# (pnpm --filter @bystro/integrations record:fakturoid). Client Credentials najdeš ve Fakturoidu
# v Nastavení → Uživatelský účet. Nepoužívá je aplikace, jen ten skript.
FAKTUROID_RECORD_CLIENT_ID=
FAKTUROID_RECORD_CLIENT_SECRET=
FAKTUROID_RECORD_SLUG=

# Klíč pro šifrování tokenů v databázi (AES-256-GCM): 32 náhodných bajtů v base64.
# Vygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Každé prostředí má vlastní klíč. Ztráta klíče = ztráta zašifrovaných tokenů.
ENCRYPTION_KEY=
